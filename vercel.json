{
  "redirects": [
    {
      "source": "/",
      "destination": "static/"
    }
  ],
   "builds": [
    { "src": "api/app.js", "use": "@vercel/node" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/app.js" },
    { "src": "/(.*)", "dest": "static/$1" }
  ]
}
